# Copy to a local *.tfvars file. Do not put credentials or secret values in it.
project_id                   = "replace-with-owner-managed-project-id"
region                       = "asia-northeast1"
environment                  = "production"
system_name                  = "lotus-brain"
app_subnet_cidr              = "10.70.0.0/24"
worker_subnet_cidr           = "10.70.1.0/24"
private_services_access_cidr = "10.70.16.0/20"

# Required for a real apply. Select an owner-approved backup location, such as
# "asia" or a Japan-only location, according to the production data-residency policy.
cloud_sql_backup_location = "replace-with-approved-backup-location"

# Required for a real apply. Cloud SQL maintenance windows use UTC: 1 is Monday
# through 7 Sunday, and hours are 0 through 23.
cloud_sql_maintenance_day  = 7
cloud_sql_maintenance_hour = 18

# First apply requires actual immutable image digests pushed by the release owner.
# Do not use tags such as :latest or :main.
cloud_run_web_image = "asia-northeast1-docker.pkg.dev/replace-with-project-id/lotus-brain-prod/web@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
cloud_run_api_image = "asia-northeast1-docker.pkg.dev/replace-with-project-id/lotus-brain-prod/api@sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

# Supply the owner-approved production domain. The Web image must be built with
# NEXT_PUBLIC_API_BASE_URL="${production_web_base_url}/api/v1" after this is known.
production_web_base_url = "https://brain.example.com"
webauthn_rp_name        = "Lotus BRAIN"
webauthn_rp_id          = "example.com"

# Channels are created and owned outside this Terraform root. Use only resource
# IDs here; do not commit an email address, chat webhook, or other recipient.
monitoring_notification_channel_ids = [
  "projects/replace-with-project-id/notificationChannels/1234567890123456",
]

# Keep false until the Certificate Manager certificate is ACTIVE, the production
# A record has been cut over, and Web/API/WebAuthn smoke checks have passed.
enable_external_uptime_monitoring = false

# SMTP credentials remain in Secret Manager. Do not put secrets in this file.
smtp_host   = "smtp.example.com"
smtp_port   = 587
smtp_secure = false
smtp_from   = "Lotus BRAIN <no-reply@example.com>"

# Numeric versions identify pre-existing operator-created secret versions.
# Keep real production values only in an ignored production tfvars file.
database_url_secret_version  = "1"
smtp_user_secret_version     = "1"
smtp_password_secret_version = "1"
