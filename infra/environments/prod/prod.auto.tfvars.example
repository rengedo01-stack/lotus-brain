# Copy to a local *.tfvars file. Do not put credentials or secret values in it.
project_id                   = "replace-with-owner-managed-project-id"
region                       = "asia-northeast1"
environment                  = "production"
system_name                  = "lotus-brain"
deployment_stage             = "foundation"
app_subnet_cidr              = "10.70.0.0/24"
worker_subnet_cidr           = "10.70.1.0/24"
private_services_access_cidr = "10.70.16.0/20"

# Required for a real apply. Select an owner-approved backup location, such as
# "asia" or a Japan-only location, according to the production data-residency policy.
cloud_sql_backup_location = "replace-with-approved-backup-location"

# Required for a real apply. Cloud SQL maintenance windows use UTC: 1 is Monday
# through 7 Sunday, and hours are 0 through 23.
cloud_sql_maintenance_day  = 7
cloud_sql_maintenance_hour = 18

# This is a foundation-only shape. Do not add fake values for later stages.
#
# migration: add only a real API-family @sha256 digest and an existing numeric
# DATABASE_URL secret version after DB ownership/connectivity proof succeeds.
# runtime: additionally add real Web/API digests, SMTP configuration and numeric
# SMTP secret versions, the approved HTTPS origin, WebAuthn values, and real
# Monitoring notification channel resource IDs.
# edge: keep the runtime inputs and leave enable_external_uptime_monitoring=false
# until DNS cutover and public smoke checks succeed.
#
# No committed example is an apply-ready production file. Production tfvars stay
# local/untracked and never contain secret payloads, placeholders, fake digests,
# fake secret versions, or fake notification-channel resource IDs.
