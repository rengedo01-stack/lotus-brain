NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=debug
POSTGRES_DB=lotus_brain
POSTGRES_USER=lotus_brain
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://lotus_brain:change-me@localhost:5432/lotus_brain?schema=public
# Production requires an HTTPS value plus the complete SMTP configuration.
PUBLIC_WEB_BASE_URL=http://localhost:3000
# WebAuthn relies exclusively on these trusted startup configuration values.
# Production requires an HTTPS origin and an explicit RP ID.
WEBAUTHN_RP_NAME=Lotus BRAIN
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
