{
  "name": "@lotus-brain/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "pnpm run prisma:generate && nest build",
    "start": "node dist/main",
    "lint": "eslint \"src/**/*.ts\" --max-warnings=0",
    "test:unit": "node --test test/post-purchase.use-case.test.cjs",
    "prisma:validate": "prisma validate --config ./prisma.config.ts",
    "prisma:generate": "prisma generate --config ./prisma.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.6",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "nestjs-pino": "^4.6.1",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@nestjs/cli": "^11.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.0.0",
    "prisma": "^7.9.1",
    "typescript": "^5",
    "typescript-eslint": "^8.0.0"
  }
}
