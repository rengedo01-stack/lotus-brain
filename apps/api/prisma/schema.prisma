generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum MasterStatus {
  ACTIVE
  INACTIVE
}

enum UserStatus {
  ACTIVE
  DISABLED
  LOCKED
}

enum AuthorizationAuditAction {
  GRANT_SYSTEM_ADMIN
  CREATE_CUSTOM_ROLE
  UPDATE_CUSTOM_ROLE
  GRANT_ROLE_PERMISSION
  REVOKE_ROLE_PERMISSION
  GRANT_USER_ROLE
  REVOKE_USER_ROLE
}

enum AuthorizationAuditSource {
  SERVER_CLI
  AUTHORIZATION_API
}

enum IdentityAuditAction {
  UPDATE_USER_STATUS
  SOFT_DELETE_USER
  CHANGE_PASSWORD
  EMAIL_VERIFICATION_REQUESTED
  EMAIL_VERIFIED
  PASSWORD_RECOVERY_REQUESTED
  PASSWORD_RESET_COMPLETED
  USER_INVITATION_CREATED
  USER_INVITATION_RESENT
  USER_INVITATION_CANCELLED
  USER_INVITATION_ACCEPTED
  PASSKEY_REGISTERED
  PASSKEY_RENAMED
  PASSKEY_REVOKED
  PASSKEY_MFA_ENABLED
  PASSKEY_MFA_DISABLED
  PASSKEYS_RESET_BY_RECOVERY
}

enum NotificationOutboxKind {
  EMAIL_VERIFICATION
  PASSWORD_RECOVERY
  PASSWORD_RESET_COMPLETED
  USER_INVITATION
  PASSKEY_REGISTERED
  PASSKEY_MFA_ENABLED
  PASSKEY_MFA_DISABLED
  AUTHENTICATORS_RESET_BY_RECOVERY
}

enum WebAuthnStepUpPurpose {
  ENABLE_MFA
  DISABLE_MFA
}

enum NotificationOutboxStatus {
  PENDING
  PROCESSING
  SENT
  DEAD
  CANCELLED
}

enum RoleStatus {
  ACTIVE
  DISABLED
}

enum UserInvitationStatus {
  PENDING
  ACCEPTED
  CANCELLED
}

enum UnitDimension {
  COUNT
  MASS
  VOLUME
}

enum InventoryTransactionType {
  RECEIPT
  CONSUMPTION
  PRODUCTION_RECEIPT
  STOCKTAKE_ADJUSTMENT
  MANUAL_ADJUSTMENT
}

enum PurchaseStatus {
  DRAFT
  CONFIRMED
  POSTED
  CANCELLED
}

enum PurchaseLogEventType {
  CREATED
  STATUS_CHANGED
  IMPORTED
}

enum RecipeStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductionStatus {
  DRAFT
  CONFIRMED
  POSTED
  CANCELLED
}

enum ProductionLogEventType {
  STATUS_CHANGED
}

enum StocktakeStatus {
  DRAFT
  CONFIRMED
  POSTED
  CANCELLED
}

enum InventoryAdjustmentStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum InventoryAdjustmentReason {
  STOCKTAKE_DIFFERENCE
  SHRINKAGE
  DAMAGE
  ROUNDING
  OTHER
}

model Unit {
  id        String        @id @default(cuid())
  code      String        @unique
  name      String
  symbol    String
  dimension UnitDimension
  status    MasterStatus  @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  baseUnitProducts          Product[]                 @relation("ProductBaseUnit")
  inventoryUnitProducts     Product[]                 @relation("ProductInventoryUnit")
  productConversions        ProductUnitConversion[]
  priceHistories            PriceHistory[]            @relation("PriceHistoryInventoryUnit")
  inventoryHistories        InventoryHistory[]        @relation("InventoryHistoryInventoryUnit")
  purchaseItems             PurchaseItem[]            @relation("PurchaseItemInventoryUnit")
  recipeYields              Recipe[]                  @relation("RecipeYieldUnit")
  recipeItems               RecipeItem[]              @relation("RecipeItemUnit")
  productionOutputSnapshots Production[]              @relation("ProductionOutputUnitSnapshot")
  consumptionRecipeUnits    ProductionConsumption[]   @relation("ProductionConsumptionRecipeUnit")
  consumptionInventoryUnits ProductionConsumption[]   @relation("ProductionConsumptionInventoryUnit")
  stocktakeItems            StocktakeItem[]
  inventoryAdjustmentItems  InventoryAdjustmentItem[]

  @@index([dimension, status])
}

model Product {
  id              String       @id @default(cuid())
  code            String       @unique
  name            String
  description     String?
  baseUnitId      String
  inventoryUnitId String
  status          MasterStatus @default(ACTIVE)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?

  // All product conversions normalize to this unit for unambiguous calculations.
  baseUnit      Unit @relation("ProductBaseUnit", fields: [baseUnitId], references: [id], onDelete: Restrict)
  // Purchase and inventory quantities use this common unit in v1.
  inventoryUnit Unit @relation("ProductInventoryUnit", fields: [inventoryUnitId], references: [id], onDelete: Restrict)

  unitConversions           ProductUnitConversion[]
  priceMasters              PriceMaster[]
  inventory                 Inventory?
  purchaseItems             PurchaseItem[]            @relation("PurchaseItemProductInventoryUnit")
  outputRecipes             Recipe[]                  @relation("RecipeOutputProduct")
  productionOutputSnapshots Production[]              @relation("ProductionOutputProductSnapshot")
  recipeItems               RecipeItem[]              @relation("RecipeItemProduct")
  consumptions              ProductionConsumption[]   @relation("ProductionConsumptionProductInventoryUnit")
  stocktakeItems            StocktakeItem[]
  inventoryAdjustmentItems  InventoryAdjustmentItem[]

  // Supports PurchaseItem's composite foreign key, which guarantees that every
  // recorded purchase quantity uses this product's inventory unit.
  @@unique([id, inventoryUnitId])
  @@index([status, deletedAt])
  @@index([baseUnitId])
  @@index([inventoryUnitId])
}

model ProductUnitConversion {
  id               String       @id @default(cuid())
  productId        String
  unitId           String
  // One unit expressed in the product's base unit. A DB constraint requires a positive value.
  factorToBaseUnit Decimal      @db.Decimal(24, 9)
  status           MasterStatus @default(ACTIVE)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  unit    Unit    @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@unique([productId, unitId])
  @@index([unitId, status])
}

model Supplier {
  id        String       @id @default(cuid())
  code      String       @unique
  name      String
  status    MasterStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?

  priceMasters PriceMaster[]
  purchases    Purchase[]

  @@index([status, deletedAt])
}

model User {
  id                          String     @id @default(cuid())
  email                       String     @unique
  displayName                 String
  passwordHash                String
  credentialVersion           Int        @default(1)
  authenticationPolicyVersion Int        @default(1)
  passkeyMfaEnabledAt         DateTime?
  emailVerifiedAt             DateTime?
  emailVerificationVersion    Int        @default(1)
  status                      UserStatus @default(ACTIVE)
  lastLoginAt                 DateTime?
  createdAt                   DateTime   @default(now())
  updatedAt                   DateTime   @updatedAt
  deletedAt                   DateTime?

  sessions                       IdentitySession[]
  userRoles                      UserRole[]
  authorizationAuditActions      AuthorizationAuditLog[]         @relation("AuthorizationAuditActorUser")
  authorizationAuditLogs         AuthorizationAuditLog[]         @relation("AuthorizationAuditTargetUser")
  identityAuditActions           IdentityAuditLog[]              @relation("IdentityAuditActorUser")
  identityAuditLogs              IdentityAuditLog[]              @relation("IdentityAuditTargetUser")
  emailVerificationTokens        EmailVerificationToken[]
  notificationOutbox             NotificationOutbox[]
  passwordRecoveryTokens         PasswordRecoveryToken[]
  createdInvitations             UserInvitation[]                @relation("UserInvitationCreatedBy")
  webAuthnCredentials            WebAuthnCredential[]
  webAuthnRegistrationChallenges WebAuthnRegistrationChallenge[]
  webAuthnStepUpChallenges       WebAuthnStepUpChallenge[]
  passkeyMfaLoginTransactions    PasskeyMfaLoginTransaction[]

  @@index([status, deletedAt])
}

model IdentitySession {
  id                          String    @id @default(cuid())
  userId                      String
  tokenHash                   String    @unique
  csrfTokenHash               String    @unique
  credentialVersion           Int
  authenticationPolicyVersion Int       @default(1)
  expiresAt                   DateTime
  // A freshly verified login remains non-authenticating until the client has
  // validated the login response and explicitly activates this exact session.
  activatedAt                 DateTime?
  revokedAt                   DateTime?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
  lastSeenAt                  DateTime?
  userAgent                   String?
  ipAddress                   String?

  user                           User                            @relation(fields: [userId], references: [id], onDelete: Restrict)
  webAuthnRegistrationChallenges WebAuthnRegistrationChallenge[]
  webAuthnStepUpChallenges       WebAuthnStepUpChallenge[]

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt, revokedAt])
}

model EmailVerificationToken {
  id                   String    @id @default(cuid())
  userId               String
  tokenHash            String    @unique
  emailVersionSnapshot Int
  expiresAt            DateTime
  consumedAt           DateTime?
  invalidatedAt        DateTime?
  createdAt            DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, emailVersionSnapshot])
  @@index([expiresAt])
}

model PasswordRecoveryToken {
  id                               String    @id @default(cuid())
  userId                           String
  tokenHash                        String    @unique
  credentialVersionSnapshot        Int
  emailVerificationVersionSnapshot Int
  expiresAt                        DateTime
  consumedAt                       DateTime?
  invalidatedAt                    DateTime?
  createdAt                        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([expiresAt])
}

model UserInvitation {
  id              String               @id @default(cuid())
  email           String
  status          UserInvitationStatus @default(PENDING)
  createdByUserId String
  createdAt       DateTime             @default(now())
  acceptedAt      DateTime?
  cancelledAt     DateTime?

  createdByUser      User                  @relation("UserInvitationCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  tokens             UserInvitationToken[]
  notificationOutbox NotificationOutbox[]

  @@index([status, createdAt])
  @@index([createdByUserId, createdAt])
}

model UserInvitationToken {
  id            String    @id @default(cuid())
  invitationId  String
  tokenHash     String    @unique
  expiresAt     DateTime
  consumedAt    DateTime?
  invalidatedAt DateTime?
  createdAt     DateTime  @default(now())

  invitation UserInvitation @relation(fields: [invitationId], references: [id], onDelete: Restrict)

  @@index([invitationId, expiresAt])
  @@index([expiresAt])
}

model WebAuthnCredential {
  id           String    @id @default(cuid())
  userId       String
  credentialId String    @unique
  publicKey    Bytes
  counter      BigInt
  transports   String[]
  deviceType   String?
  backedUp     Boolean?
  displayName  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastUsedAt   DateTime?
  revokedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([userId, revokedAt])
}

model WebAuthnRegistrationChallenge {
  id                        String    @id @default(cuid())
  userId                    String
  identitySessionId         String
  challengeHash             String    @unique
  credentialVersionSnapshot Int
  expiresAt                 DateTime
  consumedAt                DateTime?
  invalidatedAt             DateTime?
  createdAt                 DateTime  @default(now())

  user            User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  identitySession IdentitySession @relation(fields: [identitySessionId], references: [id], onDelete: Restrict)

  @@index([userId, identitySessionId, expiresAt])
  @@index([expiresAt])
}

model WebAuthnStepUpChallenge {
  id                                  String                @id @default(cuid())
  userId                              String
  identitySessionId                   String
  purpose                             WebAuthnStepUpPurpose
  challengeHash                       String                @unique
  credentialVersionSnapshot           Int
  authenticationPolicyVersionSnapshot Int
  expiresAt                           DateTime
  consumedAt                          DateTime?
  invalidatedAt                       DateTime?
  createdAt                           DateTime              @default(now())

  user            User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  identitySession IdentitySession @relation(fields: [identitySessionId], references: [id], onDelete: Restrict)

  @@index([userId, identitySessionId, expiresAt])
  @@index([expiresAt])
}

model PasskeyMfaLoginTransaction {
  id                                  String    @id @default(cuid())
  userId                              String
  transactionTokenHash                String    @unique
  csrfTokenHash                       String    @unique
  challengeHash                       String    @unique
  credentialVersionSnapshot           Int
  authenticationPolicyVersionSnapshot Int
  expiresAt                           DateTime
  consumedAt                          DateTime?
  createdAt                           DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model NotificationOutbox {
  id                        String                   @id @default(cuid())
  kind                      NotificationOutboxKind
  userId                    String?
  invitationId              String?
  destinationAddress        String?
  emailVersionSnapshot      Int?
  credentialVersionSnapshot Int?
  status                    NotificationOutboxStatus @default(PENDING)
  attemptCount              Int                      @default(0)
  nextAttemptAt             DateTime                 @default(now())
  leaseUntil                DateTime?
  claimedBy                 String?
  createdAt                 DateTime                 @default(now())
  sentAt                    DateTime?
  terminalAt                DateTime?
  lastErrorCode             String?

  user       User?           @relation(fields: [userId], references: [id], onDelete: Restrict)
  invitation UserInvitation? @relation(fields: [invitationId], references: [id], onDelete: Restrict)

  @@index([status, nextAttemptAt])
  @@index([userId, createdAt])
  @@index([invitationId, createdAt])
  @@index([leaseUntil])
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())

  rolePermissions        RolePermission[]
  authorizationAuditLogs AuthorizationAuditLog[]
}

model Role {
  id          String     @id @default(cuid())
  code        String     @unique
  name        String
  description String?
  isSystem    Boolean    @default(false)
  status      RoleStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  userRoles              UserRole[]
  rolePermissions        RolePermission[]
  authorizationAuditLogs AuthorizationAuditLog[]
}

model UserRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model AuthorizationAuditLog {
  id           String                   @id @default(cuid())
  action       AuthorizationAuditAction
  source       AuthorizationAuditSource
  actorUserId  String?
  targetUserId String?
  roleId       String?
  permissionId String?
  beforeState  Json?
  afterState   Json?
  createdAt    DateTime                 @default(now())

  actorUser  User?       @relation("AuthorizationAuditActorUser", fields: [actorUserId], references: [id], onDelete: Restrict)
  targetUser User?       @relation("AuthorizationAuditTargetUser", fields: [targetUserId], references: [id], onDelete: Restrict)
  role       Role?       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission Permission? @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@index([targetUserId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([roleId])
  @@index([permissionId])
}

model IdentityAuditLog {
  id           String              @id @default(cuid())
  action       IdentityAuditAction
  actorUserId  String?
  targetUserId String?
  beforeState  Json?
  afterState   Json?
  createdAt    DateTime            @default(now())

  actorUser  User? @relation("IdentityAuditActorUser", fields: [actorUserId], references: [id], onDelete: Restrict)
  targetUser User? @relation("IdentityAuditTargetUser", fields: [targetUserId], references: [id], onDelete: Restrict)

  @@index([actorUserId, createdAt])
  @@index([targetUserId, createdAt])
}

model PriceMaster {
  id                      String       @id @default(cuid())
  productId               String
  supplierId              String
  // The current price is always expressed per Product.inventoryUnit in v1 and cannot be negative.
  currentUnitPrice        Decimal      @db.Decimal(20, 6)
  currency                String       @default("JPY") @db.Char(3)
  currentPriceEffectiveAt DateTime     @default(now())
  status                  MasterStatus @default(ACTIVE)
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  deletedAt               DateTime?

  product        Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  supplier       Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  priceHistories PriceHistory[]

  @@unique([productId, supplierId])
  @@index([productId, status])
  @@index([supplierId, status])
}

model PriceHistory {
  id                   String   @id @default(cuid())
  priceMasterId        String
  // When present, one historical price snapshot is attributable to exactly one
  // purchase line. Manual price changes can leave this unset.
  sourcePurchaseItemId String?  @unique
  // Snapshot the inventory unit so price history remains interpretable after master changes.
  inventoryUnitId      String
  unitPrice            Decimal  @db.Decimal(20, 6)
  currency             String   @db.Char(3)
  effectiveAt          DateTime
  note                 String?
  createdAt            DateTime @default(now())

  priceMaster        PriceMaster   @relation(fields: [priceMasterId], references: [id], onDelete: Restrict)
  sourcePurchaseItem PurchaseItem? @relation("PriceHistorySourcePurchaseItem", fields: [sourcePurchaseItemId], references: [id], onDelete: Restrict)
  inventoryUnit      Unit          @relation("PriceHistoryInventoryUnit", fields: [inventoryUnitId], references: [id], onDelete: Restrict)

  @@index([priceMasterId, effectiveAt])
  @@index([inventoryUnitId])
}

model Inventory {
  id              String   @id @default(cuid())
  productId       String   @unique
  // Current quantity is expressed in Product.inventoryUnit.
  quantity        Decimal  @default(0) @db.Decimal(24, 9)
  // Per inventory unit. NULL represents inventory that has never received a
  // valued receipt; a zero quantity retains its last known average cost.
  averageUnitCost Decimal? @db.Decimal(20, 6)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product                  Product                   @relation(fields: [productId], references: [id], onDelete: Restrict)
  histories                InventoryHistory[]
  inventoryAdjustmentItems InventoryAdjustmentItem[]
}

model InventoryHistory {
  id                              String                   @id @default(cuid())
  inventoryId                     String
  // A purchase item can create at most one receipt history, making a retry or
  // duplicate POSTED transition unable to create a second stock movement. A
  // PostgreSQL trigger also permits this source only while its Purchase is POSTED.
  sourcePurchaseItemId            String?                  @unique
  // A production consumption can create at most one stock-consumption history.
  // A PostgreSQL trigger permits this source only while its Production is POSTED.
  sourceProductionConsumptionId   String?                  @unique
  sourceProductionId              String?                  @unique
  // A stocktake adjustment item can create at most one inventory adjustment
  // history entry.
  sourceInventoryAdjustmentItemId String?                  @unique
  // Snapshot the inventory unit to preserve the meaning of past quantities.
  inventoryUnitId                 String
  type                            InventoryTransactionType
  quantityDelta                   Decimal                  @db.Decimal(24, 9)
  quantityAfter                   Decimal                  @db.Decimal(24, 9)
  occurredAt                      DateTime                 @default(now())
  note                            String?
  createdAt                       DateTime                 @default(now())

  inventory                     Inventory                @relation(fields: [inventoryId], references: [id], onDelete: Restrict)
  sourcePurchaseItem            PurchaseItem?            @relation("InventoryHistorySourcePurchaseItem", fields: [sourcePurchaseItemId], references: [id], onDelete: Restrict)
  sourceProductionConsumption   ProductionConsumption?   @relation("InventoryHistorySourceProductionConsumption", fields: [sourceProductionConsumptionId], references: [id], onDelete: Restrict)
  sourceProduction              Production?              @relation("InventoryHistorySourceProduction", fields: [sourceProductionId], references: [id], onDelete: Restrict)
  sourceInventoryAdjustmentItem InventoryAdjustmentItem? @relation("InventoryHistorySourceInventoryAdjustmentItem", fields: [sourceInventoryAdjustmentItemId], references: [id], onDelete: Restrict)
  inventoryUnit                 Unit                     @relation("InventoryHistoryInventoryUnit", fields: [inventoryUnitId], references: [id], onDelete: Restrict)

  @@index([inventoryId, occurredAt])
  @@index([inventoryUnitId, occurredAt])
  @@index([type, occurredAt])
}

model Purchase {
  id             String         @id @default(cuid())
  supplierId     String
  purchaseDate   DateTime
  documentNumber String?        @db.VarChar(100)
  status         PurchaseStatus @default(DRAFT)
  // Totals are monetary snapshots in Purchase.currency and are non-negative.
  currency       String         @default("JPY") @db.Char(3)
  subtotal       Decimal        @default(0) @db.Decimal(20, 6)
  tax            Decimal        @default(0) @db.Decimal(20, 6)
  total          Decimal        @default(0) @db.Decimal(20, 6)
  note           String?
  postedAt       DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  supplier Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items    PurchaseItem[]
  logs     PurchaseLog[]

  // A supplier's document number is idempotent when it is available; PostgreSQL
  // permits multiple nulls for purchases that do not yet have a document number.
  @@unique([supplierId, documentNumber])
  @@index([supplierId, purchaseDate])
  @@index([status, purchaseDate])
}

model PurchaseItem {
  id             String    @id @default(cuid())
  purchaseId     String
  productId      String
  // Stored with productId as a composite FK to Product.inventoryUnitId. This
  // keeps purchase and inventory quantities in the same unit in v1.
  unitId         String
  lineNumber     Int
  quantity       Decimal   @db.Decimal(24, 9)
  unitPrice      Decimal   @db.Decimal(20, 6)
  lineAmount     Decimal   @db.Decimal(20, 6)
  // A fraction from 0 through 1 (for example, 0.10 means 10%).
  taxRate        Decimal   @default(0) @db.Decimal(5, 4)
  // A database-managed immutable audit marker. Triggers set it when price or
  // inventory history first references the item, preventing parent reassignment.
  sourceLockedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  product  Product  @relation("PurchaseItemProductInventoryUnit", fields: [productId, unitId], references: [id, inventoryUnitId], onDelete: Restrict)
  unit     Unit     @relation("PurchaseItemInventoryUnit", fields: [unitId], references: [id], onDelete: Restrict)

  // These source links allow a POSTED purchase to write all effects atomically
  // while unique constraints prevent duplicate price or stock effects per line.
  priceHistory     PriceHistory?     @relation("PriceHistorySourcePurchaseItem")
  inventoryHistory InventoryHistory? @relation("InventoryHistorySourcePurchaseItem")

  @@unique([purchaseId, lineNumber])
  @@index([productId])
  @@index([unitId])
}

model PurchaseLog {
  id         String               @id @default(cuid())
  purchaseId String
  eventType  PurchaseLogEventType
  fromStatus PurchaseStatus?
  toStatus   PurchaseStatus?
  note       String?
  occurredAt DateTime             @default(now())
  createdAt  DateTime             @default(now())

  // Purchase workflow history is intentionally separate from InventoryHistory,
  // which exclusively records real stock movements.
  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)

  @@index([purchaseId, occurredAt])
  @@index([toStatus, occurredAt])
}

model Recipe {
  id              String       @id @default(cuid())
  // Every Recipe belongs to a durable lineage. The first Recipe in a lineage
  // points to itself; later revisions retain that same rootRecipeId.
  rootRecipeId    String
  name            String
  outputProductId String
  // Yield is expressed in yieldUnitId. The database verifies that this unit is
  // convertible for outputProductId through ProductUnitConversion.
  yieldQuantity   Decimal      @db.Decimal(24, 9)
  yieldUnitId     String
  status          RecipeStatus @default(DRAFT)
  // A revision is a new Recipe row. Once a Production references this row, the
  // database locks its structural definition and its RecipeItem composition.
  revision        Int          @default(1)
  note            String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  rootRecipe    Recipe       @relation("RecipeRevisionLineage", fields: [rootRecipeId], references: [id], onDelete: Restrict)
  revisions     Recipe[]     @relation("RecipeRevisionLineage")
  outputProduct Product      @relation("RecipeOutputProduct", fields: [outputProductId], references: [id], onDelete: Restrict)
  yieldUnit     Unit         @relation("RecipeYieldUnit", fields: [yieldUnitId], references: [id], onDelete: Restrict)
  items         RecipeItem[]
  productions   Production[]

  @@unique([rootRecipeId, revision])
  @@index([status, outputProductId])
  @@index([rootRecipeId])
  @@index([yieldUnitId])
}

model RecipeItem {
  id        String   @id @default(cuid())
  recipeId  String
  productId String
  // The database verifies this unit has an active, Product-specific conversion
  // to the product inventory unit (or is the implicit base unit).
  unitId    String
  quantity  Decimal  @db.Decimal(24, 9)
  sortOrder Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipe  Recipe  @relation(fields: [recipeId], references: [id], onDelete: Restrict)
  product Product @relation("RecipeItemProduct", fields: [productId], references: [id], onDelete: Restrict)
  unit    Unit    @relation("RecipeItemUnit", fields: [unitId], references: [id], onDelete: Restrict)

  @@unique([recipeId, sortOrder])
  @@unique([recipeId, productId])
  @@index([productId])
  @@index([unitId])
}

model Production {
  id                             String           @id @default(cuid())
  recipeId                       String
  productionDate                 DateTime
  plannedQuantity                Decimal          @db.Decimal(24, 9)
  // Actual finished output, expressed in outputUnitIdSnapshot. It is required
  // only when the Production is POSTED.
  actualQuantity                 Decimal?         @db.Decimal(24, 9)
  // The database copies the output definition from Recipe when this Production
  // is created. These snapshots never follow later Recipe changes.
  outputProductIdSnapshot        String
  yieldQuantitySnapshot          Decimal          @db.Decimal(24, 9)
  outputUnitIdSnapshot           String
  // The output-unit to inventory-unit factor is fixed at draft creation. POST
  // must never follow a later ProductUnitConversion master-data change.
  outputConversionFactorSnapshot Decimal          @default(1) @db.Decimal(30, 12)
  status                         ProductionStatus @default(DRAFT)
  note                           String?
  postedAt                       DateTime?
  cancelledAt                    DateTime?
  createdAt                      DateTime         @default(now())
  updatedAt                      DateTime         @updatedAt

  recipe                 Recipe                  @relation(fields: [recipeId], references: [id], onDelete: Restrict)
  outputProductSnapshot  Product                 @relation("ProductionOutputProductSnapshot", fields: [outputProductIdSnapshot], references: [id], onDelete: Restrict)
  outputUnitSnapshot     Unit                    @relation("ProductionOutputUnitSnapshot", fields: [outputUnitIdSnapshot], references: [id], onDelete: Restrict)
  consumptions           ProductionConsumption[]
  outputInventoryHistory InventoryHistory?       @relation("InventoryHistorySourceProduction")
  logs                   ProductionLog[]

  @@index([recipeId, productionDate])
  @@index([outputProductIdSnapshot])
  @@index([outputUnitIdSnapshot])
  @@index([status, productionDate])
}

model ProductionLog {
  id           String                 @id @default(cuid())
  productionId String
  eventType    ProductionLogEventType
  fromStatus   ProductionStatus?
  toStatus     ProductionStatus?
  createdAt    DateTime               @default(now())

  production Production @relation(fields: [productionId], references: [id], onDelete: Restrict)

  @@index([productionId, createdAt])
  @@index([toStatus, createdAt])
}

model Stocktake {
  id          String          @id @default(cuid())
  status      StocktakeStatus @default(DRAFT)
  startedAt   DateTime?
  completedAt DateTime?
  note        String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  items      StocktakeItem[]
  adjustment InventoryAdjustment?

  @@index([status, createdAt])
}

model StocktakeItem {
  id                     String   @id @default(cuid())
  stocktakeId            String
  productId              String
  inventoryUnitId        String
  systemQuantitySnapshot Decimal? @db.Decimal(24, 9)
  countedQuantity        Decimal? @db.Decimal(24, 9)
  differenceQuantity     Decimal? @db.Decimal(24, 9)
  note                   String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  stocktake      Stocktake                @relation(fields: [stocktakeId], references: [id], onDelete: Restrict)
  product        Product                  @relation(fields: [productId, inventoryUnitId], references: [id, inventoryUnitId], onDelete: Restrict)
  inventoryUnit  Unit                     @relation(fields: [inventoryUnitId], references: [id], onDelete: Restrict)
  adjustmentItem InventoryAdjustmentItem? @relation("StocktakeItemAdjustmentItem")

  @@unique([stocktakeId, productId])
  @@index([productId])
  @@index([inventoryUnitId])
}

model InventoryAdjustment {
  id          String                    @id @default(cuid())
  stocktakeId String                    @unique
  status      InventoryAdjustmentStatus @default(DRAFT)
  postedAt    DateTime?
  note        String?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  stocktake Stocktake                 @relation(fields: [stocktakeId], references: [id], onDelete: Restrict)
  items     InventoryAdjustmentItem[]

  @@index([status, createdAt])
}

model InventoryAdjustmentItem {
  id              String                    @id @default(cuid())
  adjustmentId    String
  stocktakeItemId String                    @unique
  productId       String
  inventoryId     String
  inventoryUnitId String
  quantityDelta   Decimal                   @db.Decimal(24, 9)
  reason          InventoryAdjustmentReason
  note            String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  adjustment    InventoryAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Restrict)
  stocktakeItem StocktakeItem       @relation("StocktakeItemAdjustmentItem", fields: [stocktakeItemId], references: [id], onDelete: Restrict)
  product       Product             @relation(fields: [productId, inventoryUnitId], references: [id, inventoryUnitId], onDelete: Restrict)
  inventory     Inventory           @relation(fields: [inventoryId], references: [id], onDelete: Restrict)
  inventoryUnit Unit                @relation(fields: [inventoryUnitId], references: [id], onDelete: Restrict)
  history       InventoryHistory?   @relation("InventoryHistorySourceInventoryAdjustmentItem")

  @@index([adjustmentId])
  @@index([productId])
  @@index([inventoryId])
}

model ProductionConsumption {
  id                       String   @id @default(cuid())
  productionId             String
  productId                String
  lineNumber               Int
  // These are immutable production-time snapshots. They never follow later
  // ProductUnitConversion or PriceMaster changes. The database requires the
  // rounded quantity and amount formulas to match these snapshot fields.
  recipeQuantitySnapshot   Decimal  @db.Decimal(24, 9)
  recipeUnitId             String
  inventoryQuantity        Decimal  @db.Decimal(24, 9)
  inventoryUnitId          String
  conversionFactorSnapshot Decimal  @db.Decimal(30, 12)
  unitCostSnapshot         Decimal  @db.Decimal(20, 6)
  amountSnapshot           Decimal  @db.Decimal(20, 6)
  currency                 String   @default("JPY") @db.Char(3)
  createdAt                DateTime @default(now())

  production       Production        @relation(fields: [productionId], references: [id], onDelete: Restrict)
  // This composite foreign key keeps the consumption snapshot in the product's
  // inventory unit at the time the consumption is recorded.
  product          Product           @relation("ProductionConsumptionProductInventoryUnit", fields: [productId, inventoryUnitId], references: [id, inventoryUnitId], onDelete: Restrict)
  recipeUnit       Unit              @relation("ProductionConsumptionRecipeUnit", fields: [recipeUnitId], references: [id], onDelete: Restrict)
  inventoryUnit    Unit              @relation("ProductionConsumptionInventoryUnit", fields: [inventoryUnitId], references: [id], onDelete: Restrict)
  inventoryHistory InventoryHistory? @relation("InventoryHistorySourceProductionConsumption")

  @@unique([productionId, lineNumber])
  @@index([productId])
  @@index([recipeUnitId])
  @@index([inventoryUnitId])
}
